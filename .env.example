# Scarner — Configurazione opzionale provider futuri
# La Fase 1 funziona completamente in locale senza alcuna chiave API.

# Provider dati veicolo esterno (opzionale)
# VEHICLE_API_BASE_URL=
# VEHICLE_API_KEY=

# Fase 2 — Motore OCR / ALPR opzionale (in alternativa a OCR client-side gratuito)
# PLATE_OCR_PROVIDER=client-tesseract
# PLATE_OCR_API_KEY=
